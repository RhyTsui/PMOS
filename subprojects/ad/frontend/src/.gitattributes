# Git Attributes - 统一文件编码和换行符处理
# 防止 Git 自动转换破坏中文文件编码

# 默认：所有文本文件使用 LF
* text=auto eol=lf

# 明确标记文本文件
*.{ts,tsx,js,jsx,mjs,cjs} text eol=lf
*.{json,jsonc} text eol=lf
*.{md,mdx} text eol=lf
*.{html,htm} text eol=lf
*.{css,scss,sass,less} text eol=lf
*.{yaml,yml} text eol=lf
*.{xml,svg} text eol=lf
*.{csv,tsv} text eol=lf
*.{txt,toml,ini,cfg,conf} text eol=lf
*.{sh,bash} text eol=lf
.env* text eol=lf

# Windows 脚本保持 CRLF
*.{bat,cmd} text eol=crlf
*.ps1 text eol=crlf

# 二进制文件 - 不处理
*.{png,jpg,jpeg,gif,ico,webp} binary
*.{woff,woff2,ttf,eot,otf} binary
*.{pdf,doc,docx,xls,xlsx,ppt,pptx} binary
*.{zip,tar,gz,bz2,7z,rar} binary
*.{mp3,mp4,avi,mov,wav,flac} binary
*.{exe,dll,so,dylib} binary

# 强制 UTF-8 编码（通过 .editorconfig 配合）
# Git 本身不直接支持编码声明，但 .editorconfig 会处理
