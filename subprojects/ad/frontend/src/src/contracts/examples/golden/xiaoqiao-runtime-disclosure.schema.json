{
  "screenId": "xiaoqiao-runtime-disclosure",
  "screenType": "runtime-disclosure-panel",
  "title": "运行过程",
  "lastUpdatedAt": "2026-06-22",
  "layout": {
    "desktop": {
      "shell": "right-side-disclosure-panel",
      "content": "tabbed-runtime-disclosure",
      "stickyRegions": ["tabList"]
    },
    "mobile": {
      "shell": "full-height-drawer",
      "entry": "message-source-action",
      "stackOrder": ["overview", "execution", "evidence", "fields", "qualityChecks", "rawInfo"],
      "overflowPolicy": "drawer-scrolls-without-composer-overlap"
    }
  },
  "regions": [
    {
      "id": "overview",
      "componentBinding": "disclosure-overview",
      "purpose": "用用户可理解的摘要展示本次处理状态、关键提示和质量标签。",
      "states": ["ready", "partial", "empty", "blocked", "failed", "degraded"]
    },
    {
      "id": "execution",
      "componentBinding": "runtime-timeline",
      "purpose": "展示计划、执行步骤、工具调用和失败归一化信息。",
      "states": ["idle", "planning", "running", "succeeded", "partially-succeeded", "failed", "cancelled"]
    },
    {
      "id": "evidence",
      "componentBinding": "source-and-evidence-list",
      "purpose": "展示来源和证据引用，缺少依据时给出安全空态。",
      "states": ["ready", "empty", "redacted", "permissionDenied"]
    },
    {
      "id": "fields",
      "componentBinding": "field-catalog",
      "purpose": "展示本次处理使用和缺失的关键字段，不用于决定执行路径。",
      "states": ["ready", "empty", "partial"]
    },
    {
      "id": "qualityChecks",
      "componentBinding": "quality-check-list",
      "purpose": "展示低置信、来源不足、权限遮罩和安全检查结果。",
      "states": ["pass", "warn", "fail", "pending", "empty"]
    },
    {
      "id": "rawInfo",
      "componentBinding": "redacted-raw-info",
      "purpose": "仅对有权限用户展示脱敏后的原始信息引用。",
      "states": ["available", "redacted", "blocked", "empty"]
    }
  ],
