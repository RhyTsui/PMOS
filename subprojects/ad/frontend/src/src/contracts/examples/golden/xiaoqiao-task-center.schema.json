{
  "screenId": "xiaoqiao-task-center",
  "screenType": "ai-task-center",
  "title": "自动任务",
  "lastUpdatedAt": "2026-06-22",
  "layout": {
    "desktop": {
      "shell": "workspace-surface",
      "content": "task-list-run-records-template-gallery",
      "taskCard": "multi-column-row"
    },
    "mobile": {
      "shell": "workspace-surface",
      "content": "single-column-task-cards",
      "stackOrder": ["headerActions", "tabs", "taskCards", "runRecords", "templates"],
      "overflowPolicy": "actions-wrap-without-title-overlap"
    }
  },
  "regions": [
    {
      "id": "headerActions",
      "componentBinding": "task-center-header-actions",
      "purpose": "提供从本次结果创建、在对话中创建和手动新建的入口。",
      "states": ["ready", "disabledWithoutResult"]
    },
    {
      "id": "taskTabs",
      "componentBinding": "task-center-tabs",
      "purpose": "在已配置任务、运行记录和模板之间切换。",
      "states": ["configured", "runs", "templates"]
    },
    {
      "id": "configuredTasks",
      "componentBinding": "automation-task-list",
      "purpose": "展示任务名称、说明、下次运行、最近结果、状态和可执行动作。",
      "states": ["loading", "empty", "ready", "error"]
    },
    {
      "id": "runRecords",
      "componentBinding": "automation-run-record-list",
      "purpose": "展示运行摘要、结果文件、可带回对话标记和依据数量。",
      "states": ["empty", "ready"]
    },
    {
      "id": "templates",
      "componentBinding": "automation-template-gallery",
      "purpose": "帮助用户从常见任务模板创建自动任务。",
      "states": ["empty", "ready"]
    },
    {
      "id": "taskActions",
      "componentBinding": "task-action-buttons",
      "purpose": "运行、暂停、开启和修改任务；移动端动作换行但不遮挡关键信息。",
      "states": ["run", "pause", "resume", "edit", "disabled"]
    }
  ],
  "sourceRefs": [
    {
      "type": "architecture",
      "path": "docs/architecture/ENTERPRISE_AI_CHAT_OS_SPEC.md",
      "note": "Task Center 属于 AI Service OS 的用户可见任务承接面。"
    },
    {
      "type": "guardrail",
      "path": "docs/operations/ui-guardrail.md",
      "note": "任务列表必须服务于明确任务和下一步动作，不做静态后台浏览。"
    },
    {
      "type": "domain-contract",
      "path": "docs/architecture/automation/automation-task-protocol.md",
      "note": "自动任务必须有运行记录、证据引用、结果入口和复用策略。"
    },
    {
      "type": "visual-reference",
      "path": "docs/review/automation-center-uischema-2026-06-02.json",
      "note": "已有自动任务中心 UISchema 作为历史基准。"
    }
  ],
