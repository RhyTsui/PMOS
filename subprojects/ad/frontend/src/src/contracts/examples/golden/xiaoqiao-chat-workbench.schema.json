    },
    {
      "id": "chat-thread",
      "path": "frontend/src/src/components/cognitive/ChatContainer.tsx",
      "note": "消息、来源入口、继续追问和生成中状态的会话主体。"
    },
    {
      "id": "composer",
      "path": "frontend/src/src/components/cognitive/InputArea.tsx",
      "note": "输入、附件、引用资料和停止生成入口。"
    },
    {
      "id": "history",
      "path": "frontend/src/src/components/workspace/TaskSidebar.tsx",
      "note": "历史记录、新对话、搜索和用户菜单入口。"
    }
  ],
  "recommendedActions": [
    {
      "id": "start-new-conversation",
      "label": "开启新对话",
      "target": "historyNavigation"
    },
    {
      "id": "continue-with-current-context",
      "label": "继续处理当前问题",
      "target": "composer"
    },
    {
      "id": "open-disclosure",
      "label": "查看依据和过程",
      "target": "rightContext"
    }
  ],
  "acceptance": {
    "noTraditionalDashboardShell": true,
    "noEngineeringJargonInUserCopy": true,
    "noBusinessKeywordRoutingInUi": true,
    "supportsMobileStacking": true,
    "coversLoadingErrorEmptyPermission": true
  }
