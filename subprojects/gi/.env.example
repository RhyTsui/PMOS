# 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 服务配置 =====
PORT=8003
NODE_ENV=local

# ===== 外部服务 URL =====
# RSSHub（Docker 部署后填写）
RSSHUB_URL=http://localhost:1200

# WeWe RSS（Docker 部署后填写）
WEWE_RSS_URL=http://localhost:4000

# changedetection.io（Docker 部署后填写）
CHANGEDETECTION_URL=http://localhost:5000

# Crawl4AI（Python sidecar）
CRAWL4AI_URL=http://localhost:8888

# Scrapling（自适应采集引擎）
SCRAPLING_URL=http://localhost:8889

# ===== Dataki 知识库 =====
DATAKI_BASE_URL=
DATAKI_API_KEY=

# ===== LLM 配置（通义千问）=====
# 获取 API Key: https://dashscope.console.aliyun.com/
QWEN_API_KEY=
# 默认使用 DashScope 兼容模式
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
